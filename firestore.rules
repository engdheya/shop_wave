rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function owns(data) {
      return signedIn() && data.sellerId == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list, create, update, delete: if false;

      match /favorites/{productId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    // Username mappings are private. Username/password sign-in is resolved by
    // the callable function and Firebase Authentication verifies the password.
    match /usernames/{username} {
      allow read, write: if false;
    }

    match /stores/{storeId} {
      allow get, list: if isAdmin() ||
        (signedIn() && resource.data.sellerId == request.auth.uid) ||
        resource.data.status == 'active';
      allow create, update, delete: if false;
    }

    match /products/{productId} {
      allow get, list: if isAdmin() ||
        (signedIn() && resource.data.sellerId == request.auth.uid) ||
        (resource.data.isActive == true && resource.data.storeStatus == 'active');
      allow create, update, delete: if false;
    }

    match /sellerApplications/{sellerId} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == sellerId);
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Customer parent orders contain a multi-store snapshot. Sellers only read
    // their own redacted sellerOrders document, never another seller's lines.
    match /orders/{orderId} {
      allow get, list: if isAdmin() ||
        (signedIn() && resource.data.customerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /sellerOrders/{sellerOrderId} {
      allow get, list: if isAdmin() ||
        (signedIn() && resource.data.sellerId == request.auth.uid &&
          request.auth.token.seller == true && request.auth.token.sellerApproved == true);
      allow create, update, delete: if false;
    }

    match /auditEvents/{eventId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // No client-readable/writable fallback collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
